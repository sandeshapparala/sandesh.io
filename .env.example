# Firebase web SDK configuration. These are public app identifiers, not server credentials.
# Vercel runtime compatibility for firebase-admin 14 dependencies.
NODE_OPTIONS=--experimental-require-module
# Copy the values into your local/deployment environment when Firebase is integrated.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCL5UKh7W8kOdSgZsjvTPmaK2skbTmZotU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sandesh-io.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sandesh-io
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=sandesh-io.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=67435524379
NEXT_PUBLIC_FIREBASE_APP_ID=1:67435524379:web:364e2569573f6c4cd3e3be

# Server-only identity. An email address alone does not authenticate the backend.
FIREBASE_SERVICE_ACCOUNT_EMAIL=sandesh-io@sandesh-io.iam.gserviceaccount.com

# Server-only: paste the service-account JSON as one line inside single quotes.
# Never prefix these values with NEXT_PUBLIC_. Never commit real private keys.
FIREBASE_SERVICE_JSON_KEY=
# Random secret of at least 32 characters; use the same value across instances.
ENQUIRY_RATE_LIMIT_SECRET=

# Private inbox: verified Firebase Auth users only. Enable Email/Password in Firebase.
ADMIN_EMAILS=hello@sandesh.io,sandeshapparala@gmail.com
FIREBASE_PROJECT_ID=sandesh-io
# Manual replies dispatch to the agent; no WhatsApp or Gemini secrets needed here.
# Random secret of at least 32 characters, identical in both Vercel projects.
AGENT_DISPATCH_SECRET=
AGENT_WORKER_URL=https://agent.sandesh.io/api/jobs/reply
AGENT_TEST_NUMBERS=
