# Separate Vercel project rooted at apps/agent. Never commit actual credentials.
# Required by firebase-admin 14's ESM dependencies on Vercel's Node runtime.
NODE_OPTIONS=--experimental-require-module
FIREBASE_PROJECT_ID=sandesh-io
FIREBASE_SERVICE_JSON_KEY=
WHATSAPP_TRANSPORT=dualhook
DUALHOOK_API_KEY=
# Generate a random URL-safe value of at least 32 characters.
DUALHOOK_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_VERIFY_TOKEN=
# Only used for the direct Meta signature-verified route.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=
# Random secret of at least 32 characters, identical in both Vercel projects.
AGENT_DISPATCH_SECRET=
# E.164 digits without +, comma-separated; used only in internal mode.
AGENT_TEST_NUMBERS=
